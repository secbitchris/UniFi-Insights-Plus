# Lab repair overlay on the exact deployed upstream image; no base upgrade.
FROM node:22-slim AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
RUN npm run build

FROM ghcr.io/jmasarweh/unifi-log-insight@sha256:5c5aa0a01f02a581cdcd08b3269cd1417fa57352786427963bbc51c4cdd6c95f
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/secbitchris/UniFi-Insights-Plus" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="3.7.0-lab.1"
COPY VERSION /app/VERSION
COPY receiver/main.py receiver/enrichment.py receiver/backfill.py receiver/scheduler_guard.py receiver/threat_refresh.py /app/
COPY receiver/routes/abuseipdb.py receiver/routes/health.py /app/routes/
COPY --from=ui-builder /ui/dist/ /app/static/
